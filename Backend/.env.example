# Database Configuration
MONGO_URI=mongodb://localhost:27017/secureexam
MONGODB_TEST_URI=mongodb://localhost:27017/secureexam_test

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_for_security_please_change_this
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=different_secret_key_for_refresh_tokens_also_32_chars_minimum_change_this
REFRESH_TOKEN_EXPIRE=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Management
# Note: Using in-memory session store (no Redis required)
# Sessions expire after 24 hours of inactivity
# Only one concurrent session allowed per student

# Email Configuration (Future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
