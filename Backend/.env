MONGO_URI=mongodb://127.0.0.1:27017/secureexam

# JWT Configuration
JWT_SECRET=secureexam_jwt_secret_key_minimum_32_characters_long_change_in_production
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=secureexam_refresh_token_secret_different_from_jwt_secret_key
REFRESH_TOKEN_EXPIRE=7d
REQUIRE_SEB=true
# Server Configuration
PORT=3000
NODE_ENV=development
BYPASS_SEB_CHECK=true

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis Configuration (Session Management)
REDIS_URL=redis://localhost:6379

